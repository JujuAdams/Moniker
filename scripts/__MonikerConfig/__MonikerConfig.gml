// Set to `true` to show extra information in the debug log. This is useful to track down how long
// it is taking to load fonts.
#macro MONIKER_VERBOSE  true

// Whether fonts should default to preloading when making a font pack.
#macro MONIKER_DEFAULT_PRELOAD  true

// Whether Moniker names should be drawn antialiased or not. This is a global setting and will
// affect all fonts added with Moniker.
#macro MONIKER_ANTIALIAS  true